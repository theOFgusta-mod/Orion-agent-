#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
# O.R.I.O.N — Organized Responsive Intelligent Operational Navigator
# Comando global para iniciar o assistente no terminal
# Uso: orion [comando]
# ═══════════════════════════════════════════════════════════════

# ── Sem set -e: tratamos erros manualmente pra dar mensagens bonitas ──
set -uo pipefail

ORION_HOME="${ORION_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/orion}"
ORION_REPO="${ORION_HOME}/repo"
ORION_DEV="${ORION_REPO}/packages/opencode"
ORION_BIN="${HOME}/.local/bin/orion"

# Cores
R='\033[0;31m'; G='\033[0;32m'; Y='\033[38;5;214m'; C='\033[0;36m'; M='\033[0;35m'; B='\033[1m'; N='\033[0m'

banner() {
  echo -e "${M}"
  echo "  █████╗      ██████╗      ██╗           █████╗      ███╗   ██╗"
  echo " ██╔══██╗     ██╔══██╗     ██║          ██╔══██╗     ████╗  ██║"
  echo " ██║  ██║     ██████╔╝     ██║          ██║  ██║     ██╔██╗ ██║"
  echo " ██║  ██║     ██╔══██╗     ██║          ██║  ██║     ██║╚██╗██║"
  echo " ╚█████╔╝     ██║  ██║     ██║          ╚█████╔╝     ██║ ╚████║"
  echo "  ╚════╝      ╚═╝  ╚═╝     ╚═╝           ╚════╝      ╚═╝  ╚═══╝"
  echo -e "${N}"
}

help() {
  banner
  echo -e "${C}O.R.I.O.N — ${B}Assistente de terminal com personalidade${N}"
  echo ""
  echo -e "${B}Uso:${N} orion [comando]"
  echo ""
  echo "Comandos:"
  echo "  (sem argumentos)  Inicia o TUI do O.R.I.O.N"
  echo "  update            Atualiza para a versão mais recente"
  echo "  seed              Importa memórias do ~/memoria.md"
  echo "  uninstall         Remove o O.R.I.O.N do sistema"
  echo "  help              Mostra esta ajuda"
}

# ── Utilitário de erro ──
die() {
  echo -e "${R}❌ $1${N}" >&2
  echo -e "${Y}💡 $2${N}" >&2
  exit 1
}

# ── Instalação automática (se o repo não existe, baixa na hora) ──
auto_install() {
  [ -d "${ORION_DEV}" ] && return 0

  echo -e "${Y}📡 O.R.I.O.N não encontrado localmente. Baixando...${N}"
  mkdir -p "${ORION_HOME}"

  # Verificar git
  command -v git &>/dev/null || die "Git não encontrado." \
    "Instale: sudo pacman -S git | sudo apt install git | sudo dnf install git"

  # Clonar
  echo -e "${Y}📥 Clonando repositório...${N}"
  if ! git clone --depth 1 "https://github.com/theOFgusta-mod/Orion-agent-.git" "${ORION_REPO}" 2>&1; then
    die "Falha ao baixar o O.R.I.O.N." \
      "Verifique sua internet. Se persistir, tente: git clone https://github.com/theOFgusta-mod/Orion-agent-.git"
  fi

  # Instalar Bun se necessário
  if ! command -v bun &>/dev/null; then
    echo -e "${Y}📦 Instalando Bun...${N}"
    command -v curl &>/dev/null || die "curl não encontrado." "Instale: sudo pacman -S curl | sudo apt install curl"
    for attempt in 1 2 3; do
      echo -e "${Y}   Tentativa $attempt de 3...${N}"
      if curl -fsSL https://bun.sh/install | bash; then
        echo -e "${G}✅ Bun instalado!${N}"
        break
      fi
      [ "$attempt" -eq 3 ] && die "Falha ao instalar Bun." \
        "Tente: curl -fsSL https://bun.sh/install | bash"
      sleep 2
    done
    export BUN_INSTALL="${HOME}/.bun"
    export PATH="${BUN_INSTALL}/bin:${PATH}"
  fi
  echo -e "${G}✅${N} Bun $(bun --version)"

  # Instalar dependências
  echo -e "${Y}📦 Instalando dependências (pode levar alguns minutos)...${N}"
  cd "${ORION_REPO}"
  if ! bun install 2>&1; then
    echo ""
    echo -e "${Y}⚠️  bun install falhou. Causas comuns:${N}"
    echo "   • Faltam ferramentas de build (Arch: sudo pacman -S base-devel)"
    echo "   • Bun desatualizado (bun upgrade)"
    echo "   • Erro de rede (tente de novo: cd $ORION_REPO && bun install)"
    die "Instalação de dependências falhou." "Veja as sugestões acima."
  fi

  # Seed automático
  if [ -f "${HOME}/memoria.md" ]; then
    echo -e "${Y}🧠 Importando memórias...${N}"
    (cd "${ORION_DEV}" && bun run script/seed-memory.ts 2>/dev/null) || true
  fi

  echo ""
  echo -e "${G}✅ O.R.I.O.N instalado com sucesso em:${N}"
  echo "   ${ORION_HOME}"
  echo ""
  echo -e "Digite ${B}orion${N} para começar!"
}

# ── Comandos ──
update() {
  [ -d "${ORION_REPO}/.git" ] || die "O.R.I.O.N não encontrado." "Execute 'orion' para instalar primeiro."
  echo -e "${Y}🔄 Atualizando O.R.I.O.N...${N}"
  cd "${ORION_REPO}"
  git pull origin main || die "Falha ao atualizar." "Verifique sua internet."
  echo -e "${Y}📦 Atualizando dependências...${N}"
  bun install 2>&1 || die "Falha ao atualizar dependências." "Tente: cd $ORION_REPO && bun install"
  echo -e "${G}✅ Atualizado!${N}"
}

seed() {
  [ -f "${HOME}/memoria.md" ] || { echo -e "${Y}📭 ~/memoria.md não encontrado.${N}"; return; }
  cd "${ORION_DEV}"
  bun run script/seed-memory.ts 2>/dev/null || echo -e "${Y}   Seed de memória concluído.${N}"
}

uninstall() {
  echo -e "${Y}🗑️  Removendo O.R.I.O.N...${N}"
  rm -rf "${ORION_HOME}" 2>/dev/null || true
  rm -f "${ORION_BIN}" 2>/dev/null || true
  sed -i '/alias orion=/d' "${HOME}/.bashrc" 2>/dev/null || true
  sed -i '/alias orion=/d' "${HOME}/.zshrc" 2>/dev/null || true
  echo -e "${G}✅ O.R.I.O.N removido. Até mais, Senhor!${N}"
}

# ── MAIN ──
case "${1:-}" in
  help|-h|--help) help ;;
  update)         auto_install && update ;;
  seed)           auto_install && seed ;;
  uninstall)      uninstall ;;
  "")
    auto_install
    banner
    echo -e "${M}🚀 Inicializando O.R.I.O.N...${N}"
    cd "${ORION_DEV}"
    exec bun run --conditions=browser src/index.ts
    ;;
  *)
    echo -e "${R}❌ Comando desconhecido: $1${N}"
    echo "Use 'orion help'"
    exit 1
    ;;
esac
