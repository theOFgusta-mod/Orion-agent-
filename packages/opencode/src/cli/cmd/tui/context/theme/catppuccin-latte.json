{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "rosewater": "#dc8a78",
    "flamingo": "#dd7878",
    "pink": "#ea76cb",
    "mauve": "#8839ef",
    "red": "#d20f39",
    "maroon": "#e64553",
    "peach": "#fe640b",
    "yellow": "#df8e1d",
    "green": "#40a02b",
    "teal": "#179299",
    "sky": "#04a5e5",
    "sapphire": "#209fb5",
    "blue": "#1e66f5",
    "lavender": "#7287fd",
    "text": "#4c4f69",
    "subtext1": "#5c5f77",
    "subtext0": "#6c6f85",
    "overlay2": "#7c7f93",
    "overlay1": "#8c8fa1",
    "overlay0": "#9ca0b0",
    "surface2": "#acb0be",
    "surface1": "#bcc0cc",
    "surface0": "#ccd0da",
    "base": "#eff1f5",
    "mantle": "#e6e9ef",
    "crust": "#dce0e8",
    "darkBase": "#292c3c",
    "darkMantle": "#1e2030",
    "darkCrust": "#181926",
    "darkSurface0": "#363a4f",
    "darkSurface1": "#40455a",
    "darkSurface2": "#494d64"
  },
  "theme": {
    "primary": { "dark": "darkBase", "light": "base" },
    "secondary": { "dark": "mauve", "light": "mauve" },
    "accent": { "dark": "pink", "light": "pink" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "peach", "light": "peach" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "teal", "light": "teal" },
    "text": { "dark": "#cdd6f4", "light": "text" },
    "textMuted": { "dark": "#a6adc8", "light": "subtext0" },
    "background": { "dark": "darkCrust", "light": "base" },
    "backgroundPanel": { "dark": "darkMantle", "light": "mantle" },
    "backgroundElement": { "dark": "darkBase", "light": "crust" },
    "border": { "dark": "darkSurface0", "light": "surface0" },
    "borderActive": { "dark": "mauve", "light": "lavender" },
    "borderSubtle": { "dark": "darkSurface1", "light": "surface1" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "overlay2", "light": "overlay2" },
    "diffHunkHeader": { "dark": "peach", "light": "peach" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#24312b", "light": "#ddf0dd" },
    "diffRemovedBg": { "dark": "#3c2a32", "light": "#f5e0e2" },
    "diffContextBg": { "dark": "darkMantle", "light": "mantle" },
    "diffLineNumber": { "dark": "#585b70", "light": "surface2" },
    "diffAddedLineNumberBg": { "dark": "#1e2a25", "light": "#cfe6d1" },
    "diffRemovedLineNumberBg": { "dark": "#32232a", "light": "#eadddf" },
    "markdownText": { "dark": "#cdd6f4", "light": "text" },
    "markdownHeading": { "dark": "mauve", "light": "mauve" },
    "markdownLink": { "dark": "#89b4fa", "light": "blue" },
    "markdownLinkText": { "dark": "#89dceb", "light": "sky" },
    "markdownCode": { "dark": "#a6e3a1", "light": "green" },
    "markdownBlockQuote": { "dark": "#f9e2af", "light": "yellow" },
    "markdownEmph": { "dark": "#f9e2af", "light": "yellow" },
    "markdownStrong": { "dark": "#fab387", "light": "peach" },
    "markdownHorizontalRule": {
      "dark": "#a6adc8",
      "light": "subtext0"
    },
    "markdownListItem": { "dark": "#89b4fa", "light": "blue" },
    "markdownListEnumeration": { "dark": "#89dceb", "light": "sky" },
    "markdownImage": { "dark": "#89b4fa", "light": "blue" },
    "markdownImageText": { "dark": "#89dceb", "light": "sky" },
    "markdownCodeBlock": { "dark": "#cdd6f4", "light": "text" },
    "syntaxComment": { "dark": "#6c7086", "light": "overlay1" },
    "syntaxKeyword": { "dark": "#cba6f7", "light": "mauve" },
    "syntaxFunction": { "dark": "#89b4fa", "light": "blue" },
    "syntaxVariable": { "dark": "#f38ba8", "light": "red" },
    "syntaxString": { "dark": "#a6e3a1", "light": "green" },
    "syntaxNumber": { "dark": "#fab387", "light": "peach" },
    "syntaxType": { "dark": "#f9e2af", "light": "yellow" },
    "syntaxOperator": { "dark": "#89dceb", "light": "sky" },
    "syntaxPunctuation": { "dark": "#cdd6f4", "light": "text" }
  }
}
